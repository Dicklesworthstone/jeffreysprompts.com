{
  "name": "@jeffreysprompts/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "bun run ../../scripts/validate-prompts.ts && bun run ../../scripts/build-data.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ox": "oxlint",
    "lint:all": "eslint && oxlint",
    "format": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "size-limit": "size-limit",
    "size-limit:check": "size-limit --json"
  },
  "dependencies": {
    "@jeffreysprompts/core": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.78.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.562.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@size-limit/preset-app": "^14.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.1",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
